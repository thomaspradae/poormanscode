#!/usr/bin/env bash
set -euo pipefail

PROGRAM="${1:-PMCF-000006}"
PMC_DIR="/home/t/poormans-hpc/poormanscode"
PMC_BIN="$PMC_DIR/.venv/bin/pmc"
CFG="/home/t/.config/poormans-code/config.toml"
SECRETS="/home/t/.config/poormans-code/telegram.env"
STATE_DIR="/home/t/.local/share/poormans-code"
STATE_FILE="$STATE_DIR/$PROGRAM-operator-state"
LOG="$STATE_DIR/$PROGRAM-operator.log"
# Football World Lab is intentionally a fail-open experiment.  Check it often
# enough to catch an executor/session state mismatch before a full hour of
# quota and wall-clock time is wasted.
INTERVAL_SECONDS=1800

test -r "$SECRETS" || { echo "Missing $SECRETS. Run pmc-telegram-setup first." >&2; exit 1; }
# shellcheck disable=SC1090
source "$SECRETS"
mkdir -p "$STATE_DIR"
touch "$STATE_FILE"

notify() {
  # Keep the bot token out of curl's argv: `ps` and systemd status otherwise
  # expose the complete API URL to every local user who can inspect processes.
  printf 'url = "https://api.telegram.org/bot%s/sendMessage"\n' "$TELEGRAM_BOT_TOKEN" |
    curl --config - --silent --show-error --max-time 20 -X POST \
      --data-urlencode "chat_id=$TELEGRAM_CHAT_ID" \
      --data-urlencode "text=$1" >/dev/null || true
}

last_signature=""
block_luna_uses=0
block_terra_used=0
if [[ -s "$STATE_FILE" ]]; then
  # shellcheck disable=SC1090
  source "$STATE_FILE"
fi

save_block_state() {
  umask 077
  {
    printf 'last_signature=%q\n' "$last_signature"
    printf 'block_luna_uses=%q\n' "$block_luna_uses"
    printf 'block_terra_used=%q\n' "$block_terra_used"
  } >"$STATE_FILE"
}

intervene() {
  local model="$1"
  local label="$2"
  local prompt="$3"
  local result
  result="$(codex exec -m "$model" -c 'model_reasoning_effort="low"' --approve-for-me \
    -C "$PMC_DIR" "$prompt" 2>&1 || true)"
  printf '%s\n' "$result" >>"$LOG"
  notify "$label:\n$(printf '%s' "$result" | tail -20)"
}

healthy_cycles=0
while true; do
  status="$(env HOME=/home/t XDG_RUNTIME_DIR=/run/user/1000 "$PMC_BIN" --config "$CFG" program-status "$PROGRAM" 2>&1 || true)"
  first="$(printf '%s' "$status" | head -1)"
  detail="$(printf '%s' "$status" | sed -n 's/.*last_error: //p' | head -1)"
  active_job="$(printf '%s\n' "$status" | awk '$1 ~ /^PMC-/ && ($3 == "RUNNING" || $3 == "VERIFYING" || $3 == "REVIEWING") { print $1; exit }')"
  signature="$(printf '%s\n%s' "$first" "$detail" | sha256sum | cut -d' ' -f1)"
  printf '[%s] %s\n' "$(date -Is)" "$first" >>"$LOG"

  if printf '%s' "$status" | grep -q '\[BLOCKED\]'; then
    healthy_cycles=0
    if [[ "$signature" != "$last_signature" ]]; then
      notify "PMC blocked: $detail\nLuna is investigating."
      last_signature="$signature"
      block_luna_uses=0
      block_terra_used=0
    fi
    if (( block_luna_uses < 2 )); then
      block_luna_uses=$((block_luna_uses + 1))
      save_block_state
      intervene "gpt-5.6-luna" "Luna block repair ${block_luna_uses}/2" \
        "You are the overnight PMC operator. Inspect only this PMC block in $PROGRAM: $detail. The PMC database/configuration is under /home/t; use --approve-for-me escalation if needed to read it. Read the Football V0 specification and relevant PMC worktrees/logs. For the active task, obtain the live Jules session with exactly: sqlite3 /home/t/.local/share/poormans-code/pmc.db \"SELECT id,attempt_no,status,provider_request_id FROM attempts WHERE job_id='${active_job:-UNKNOWN}' ORDER BY id DESC LIMIT 1;\". Query that provider session only if an ID exists, without printing secrets. Fix only clear orchestration or code defects in the isolated task worktree; run relevant verification; preserve/checkpoint useful work and resume if repaired. Do not delete work, force-push, or accept final program output. Return a concise diagnosis and exact next action."
    elif (( block_terra_used == 0 )); then
      block_terra_used=1
      save_block_state
      notify "Two Luna repairs did not clear this block. Terra is taking one bounded pass."
      intervene "gpt-5.6-terra" "Terra escalation result" \
        "You are the senior Football World Lab operator. Two Luna-low repair attempts did not clear this exact PMC block in $PROGRAM: $detail. Inspect the active task, PMC state, live Jules session (use attempts.provider_request_id, not provider_session_id), worktree, and the V0 checklist. Take one bounded, evidence-based repair pass: fix clear orchestration/code defects, preserve/checkpoint useful work, verify, and resume if possible. Do not discard work, force-push, or accept final program output. Return diagnosis, actions taken, and exact remaining blocker."
    else
      notify "PMC remains blocked after two Luna repairs and one Terra escalation: $detail\nManual review is now required."
    fi
  else
    healthy_cycles=$((healthy_cycles + 1))
    notify "PMC hourly update:\n$first\n$(printf '%s' "$status" | tail -5)"
    # A RUNNING label alone is not enough: Jules can enter a terminal
    # provider state while PMC is still polling it.  Every healthy cycle gets
    # a cheap Luna-low inspection of the current attempt/session as well as
    # the checklist.  It may repair a clear orchestration mismatch and resume
    # this explicitly fail-open Football program; it must not rewrite the
    # football task merely because it wants a different implementation.
    audit="$(codex exec -m gpt-5.6-luna -c 'model_reasoning_effort="low"' --approve-for-me \
      -C "$PMC_DIR" \
      "You are the Football World Lab watchdog. $PROGRAM status is: ${first}. The active task is ${active_job:-NONE}. Inspect only that task if one is named; if NONE, inspect only $PROGRAM feature_tasks and identify the single nonterminal task in RUNNING/VERIFYING/REVIEWING state. Never inspect or invent a different historical PMC job ID. If it is a Jules attempt, retrieve it with: sqlite3 /home/t/.local/share/poormans-code/pmc.db \"SELECT id,attempt_no,status,provider_request_id FROM attempts WHERE job_id='${active_job:-UNKNOWN}' ORDER BY id DESC LIMIT 1;\". The session ID is provider_request_id; provider_session_id is not a column. Query provider state only if that ID exists, without printing secrets. At most four terminal commands. If provider says terminal/AWAITING_USER_FEEDBACK while PMC says running, fix the narrow PMC/Jules handoff, preserve/checkpoint work, and resume. Otherwise return a <=100-word checklist/progress audit. You may commit/push PMC orchestration fixes for this Football-only experiment, but do not discard task work or force-push." 2>&1 || true)"
    printf '%s\n' "$audit" >>"$LOG"
    notify "Luna 30-minute football audit:\n$(printf '%s' "$audit" | tail -20)"
    last_signature=""
    block_luna_uses=0
    block_terra_used=0
    save_block_state
  fi
  sleep "$INTERVAL_SECONDS"
done
