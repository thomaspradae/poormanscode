#!/usr/bin/env bash
# Copy only the Telegram processed-update high-water mark from the active
# runner. Conversation/rollout stores remain host-local by design.
set -euo pipefail

PRIMARY_HOST="${PRIMARY_HOST:-uace-ofi-01}"
STATE_DIR="${XDG_STATE_HOME:-$HOME/.local/state}/pmc-telegram-control"
DATABASE="$STATE_DIR/control.sqlite3"

remote_offset="$(
  ssh -o BatchMode=yes -o ConnectTimeout=8 "$PRIMARY_HOST" \
    "python3 -c 'import pathlib,sqlite3; p=pathlib.Path.home()/\".local/state/pmc-telegram-control/control.sqlite3\"; db=sqlite3.connect(p); row=db.execute(\"select value from metadata where key=\\\"telegram_offset\\\"\").fetchone(); print(row[0] if row else \"0\")'" \
    2>/dev/null || true
)"
[[ "$remote_offset" =~ ^[0-9]+$ ]] || exit 0

mkdir -p "$STATE_DIR"
python3 - "$DATABASE" "$remote_offset" <<'PY'
import sqlite3
import sys

path, incoming = sys.argv[1], int(sys.argv[2])
db = sqlite3.connect(path)
db.execute("CREATE TABLE IF NOT EXISTS metadata (key TEXT PRIMARY KEY, value TEXT NOT NULL)")
row = db.execute("SELECT value FROM metadata WHERE key = 'telegram_offset'").fetchone()
current = int(row[0]) if row else 0
if incoming > current:
    db.execute("INSERT INTO metadata(key, value) VALUES ('telegram_offset', ?) ON CONFLICT(key) DO UPDATE SET value = excluded.value", (str(incoming),))
db.commit()
PY
