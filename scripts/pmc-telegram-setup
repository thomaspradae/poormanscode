#!/usr/bin/env bash
set -euo pipefail

CONFIG_DIR="/home/t/.config/poormans-code"
SECRETS_FILE="$CONFIG_DIR/telegram.env"

mkdir -p "$CONFIG_DIR"
umask 077

read -r -s -p "Telegram bot token: " BOT_TOKEN
printf "\n"

if [[ -z "$BOT_TOKEN" ]]; then
  echo "Bot token is required." >&2
  exit 1
fi

UPDATES="$(curl --fail --silent --show-error --max-time 20 \
  "https://api.telegram.org/bot$BOT_TOKEN/getUpdates")"
CHAT_ID="$(printf '%s' "$UPDATES" | jq -r '
  [.result[] | (.message // .edited_message // .channel_post) | select(.chat != null) | .chat.id]
  | last // empty
')"

if [[ -z "$CHAT_ID" ]]; then
  echo "No Telegram chat found. Send /start to the bot, wait a moment, then run this again." >&2
  exit 1
fi

printf 'TELEGRAM_BOT_TOKEN=%q\nTELEGRAM_CHAT_ID=%q\n' "$BOT_TOKEN" "$CHAT_ID" >"$SECRETS_FILE"
chmod 600 "$SECRETS_FILE"

curl --fail --silent --show-error --max-time 15 \
  -X POST "https://api.telegram.org/bot$BOT_TOKEN/sendMessage" \
  --data-urlencode "chat_id=$CHAT_ID" \
  --data-urlencode "text=PMC Telegram notifications configured." >/dev/null

echo "Saved $SECRETS_FILE (mode 600), discovered chat $CHAT_ID, and sent a test message."
